{
  "functions": {
    "api/ler.js": {
      "maxDuration": 120
    },
    "api/telegram.js": {
      "maxDuration": 120
    },
    "api/cron/sync-catalogo.js": {
      "maxDuration": 120,
      "includeFiles": "data/catalogo-*.json"
    },
    "api/cron/sync-eventos.js": {
      "maxDuration": 60
    },
    "api/print.js": {
      "maxDuration": 120,
      "includeFiles": "colecao.json"
    }
  },
  "rewrites": [
    {
      "source": "/_blob/:id",
      "destination": "/blobs/:id.jpg"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-catalogo",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/sync-eventos",
      "schedule": "0 14 * * 1"
    }
  ]
}
