{
  "functions": {
    "api/ler.js": { "maxDuration": 120 },
    "api/cron/sync-catalogo.js": { "maxDuration": 120, "includeFiles": "data/catalogo-fotos.json" },
    "api/cron/sync-eventos.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/_blob/:id", "destination": "/blobs/:id.jpg" }
  ],
  "crons": [
    { "path": "/api/cron/sync-catalogo", "schedule": "0 13 * * *" },
    { "path": "/api/cron/sync-eventos", "schedule": "0 14 * * 1" }
  ]
}
